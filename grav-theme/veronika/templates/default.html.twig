<!doctype html>
<html lang="sk">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Veronika Tóth — salón krásy Nitra</title>
<meta name="description" content="Salón krásy v Nitre — permanentný make-up, manikúra, pedikúra, laserové a pleťové ošetrenia. Od roku 2005. Online rezervácia.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%2317130D'/%3E%3Ctext x='16' y='22' font-family='Georgia,serif' font-size='15' fill='%23C7A567' text-anchor='middle'%3EVT%3C/text%3E%3C/svg%3E">
<meta property="og:type" content="website">
<meta property="og:title" content="Veronika Tóth — salón krásy Nitra">
<meta property="og:description" content="Salón krásy v Nitre — permanentný make-up, nechty, laserové a pleťové ošetrenia. Od roku 2005.">
<meta property="og:image" content="https://janpochyly-coder.github.io/veronika-toth-web/navrh-2/images/hero.jpg">
<meta property="og:url" content="https://janpochyly-coder.github.io/veronika-toth-web/navrh-2/">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Marcellus&family=Mulish:wght@300;400;500;600&display=swap">

<link rel="stylesheet" href="{{ theme_url }}/css/style.css">

<header class="nav">
  <div class="wrap nav-inner">
    <div class="brand" data-go="uvod"><img class="logo-mark" src="{{ theme_url }}/images/logo-mark.png" alt="Veronika Tóth"><span class="brand-txt"><span class="bn">Veronika Tóth</span><span class="bs">Salón krásy · Nitra</span></span></div>
    <button class="menu-toggle" id="menuBtn" aria-label="Menu"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
    <nav class="links" id="navlinks">
      <button data-go="uvod" class="active">Úvod</button>
      <button data-go="sluzby">Služby</button>
      <button data-go="kurzy">Kurzy</button>
      <button data-go="cennik">Cenník</button>
      <button data-go="galeria">Galéria</button>
      <button data-go="kontakt">Kontakt</button>
    </nav>
  </div>
</header>

<main>
  <!-- UVOD -->
  <div class="view active" id="uvod">
    <section class="intro">
      <img class="intro-logo" src="{{ theme_url }}/images/logo-full.png" alt="" aria-hidden="true">
      <div class="wrap intro-grid">
        <div class="intro-photo frame"><div class="ph tall"><img src="{% set ip = page.media[page.header.intro_photo] %}{{ ip ? ip.url : theme_url ~ '/images/veronika.jpg' }}" alt="Veronika Tóth — salón krásy Nitra"></div></div>
        <div class="intro-txt">
          <span class="kicker">{{ page.header.intro_kicker }}</span>
          <h1>{{ page.header.intro_title }} <em>{{ page.header.intro_title_em }}</em></h1>
          <p class="quote">{{ page.header.intro_quote }}</p>
          <p>{{ page.header.intro_p1 }}</p>
          <p>{{ page.header.intro_p2 }}</p>
          <div class="sig">{{ page.header.intro_sign }}</div>
          <div class="intro-actions">
            <a class="btn gold" href="{{ page.header.c_booking }}" target="_blank" rel="noopener">Objednať sa online</a>
            <a class="btn" data-go="sluzby" href="#sluzby">Služby</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section-beige">
      <div class="wrap">
        <span class="dot"></span>
        <div class="pillars">
          <div class="pillar"><div class="n">I</div><h3>Estetika</h3><p>Precízna práca a cit pre detail pri každej službe.</p></div>
          <div class="pillar"><div class="n">II</div><h3>Bezpečnosť</h3><p>Kvalitné materiály a sterilné jednorazové nástroje.</p></div>
          <div class="pillar"><div class="n">III</div><h3>Skúsenosti</h3><p>V salóne krásy pôsobím už od roku 2005.</p></div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head"><span class="kicker">Čo ponúkam</span><h2>Služby nášho salónu</h2><p>Od permanentného make-upu cez nechty až po pleťovú starostlivosť — všetko na jednom mieste.</p></div>
        <div class="svc-list">
        {% for o in page.header.overview %}
          <div class="svc" data-go="{{ o.target|default('sluzby') }}" style="cursor:pointer"><span class="no">{{ '%02d'|format(loop.index) }}</span><div><h3>{{ o.title }}</h3><p>{{ o.desc }}</p></div><span class="tag">{{ o.tag|default('Zobraziť →') }}</span></div>
        {% endfor %}
        </div>
        <div style="text-align:center;margin-top:36px"><a class="btn" data-go="sluzby" href="#sluzby">Všetky služby</a></div>
      </div>
    </section>

    <!-- RECENZIE (kompaktný pásik na úvode) -->
    <section class="section-beige">
      <div class="wrap">
        <span class="kicker" style="display:block;margin-bottom:6px">Referencie</span>
        <div class="rmini">
          <div class="rq"><div class="stars">★★★★★</div><p>„Konečne obočie, ktoré vyzerá úplne prirodzene. Ráno ušetrím kopu času."</p><span>— Martina K.</span></div>
          <div class="rq"><div class="stars">★★★★★</div><p>„Profesionálka telom aj dušou. Výsledok predčil moje očakávania."</p><span>— Lucia B.</span></div>
        </div>
        <p class="pnote" style="margin-top:20px">Hodnotenia spokojných klientok</p>
        <div style="text-align:center;margin-top:14px"><a class="btn" href="https://share.google/l2OJdri5wWEotfM0E" target="_blank" rel="noopener">Recenzie na Google</a></div>
      </div>
    </section>
  </div>

  <!-- SLUZBY -->
  <div class="view" id="sluzby">
    <section>
      <div class="wrap">
        <div class="head"><span class="kicker">Služby</span><h2>Zákroky na mieru</h2><p>Každej klientke navrhujem riešenie na mieru. Kliknutím na „Prečítať viac" zobrazíte podrobný popis; ceny nájdete v cenníku.</p></div>
        <div class="vgrid">
        {% set svcicons = {
          'brow': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3 15c4-6 14-6 18-1"/><path d="M6.5 13l-1-2"/><path d="M10.5 11.6l-.6-2.2"/><path d="M14 11.2l.5-2.2"/><path d="M17.6 12.2l1.2-1.9"/></svg>',
          'lips': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M3 11c3-3 6-3 9 0 3-3 6-3 9 0-2 3.6-6 5-9 5s-7-1.4-9-5z"/><path d="M3 11h18"/></svg>',
          'laser': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M12 3l1.8 6.2L20 11l-6.2 1.8L12 19l-1.8-6.2L4 11l6.2-1.8z"/></svg>',
          'nail': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M10 3h4v2.5h-4z"/><path d="M9.5 8.5c0-1.6 1-3 2.5-3s2.5 1.4 2.5 3v8.5a1.5 1.5 0 0 1-1.5 1.5h-2a1.5 1.5 0 0 1-1.5-1.5z"/><path d="M9.5 12h5"/></svg>',
          'foot': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"><path d="M9 4C6.5 4 5 6.5 5 10c0 2.5 1 4 1 6.5 0 2 1.5 3.2 3.5 3.2s3-1.6 3-3.6c0-2 .6-3 .6-5.1"/><circle cx="15.5" cy="6" r="1"/><circle cx="17.6" cy="8.6" r="1"/><circle cx="18.2" cy="11.6" r="1"/></svg>'
        } %}
        {% for s in page.header.services %}
          <div class="vcard">
            <div class="ic">{{ svcicons[s.icon]|default(svcicons['brow'])|raw }}</div>
            <h3>{{ s.title }}</h3><span class="tag">{{ s.tag }}</span>
            <p class="lead2">{{ s.short }}</p>
            {% if s.long %}<details class="more"><summary>Prečítať viac</summary><div class="more-body">{{ s.long|markdown }}</div></details>{% endif %}
          </div>
        {% endfor %}
        </div>

        <div style="text-align:center;margin-top:clamp(40px,6vw,64px);display:flex;gap:16px;justify-content:center;flex-wrap:wrap">
          <a class="btn gold" href="{{ page.header.c_booking }}" target="_blank" rel="noopener">Objednať sa online</a>
          <a class="btn" data-go="cennik" href="#cennik">Pozrieť cenník</a>
        </div>
      </div>
    </section>

    <section class="section-beige">
      <div class="wrap">
        <div class="head"><span class="kicker">Časté otázky</span><h2>Čo vás najčastejšie zaujíma</h2></div>
        <div class="faq">
        {% for f in page.header.faq %}
          <details class="q"{% if loop.first %} open{% endif %}><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>
        {% endfor %}
        </div>

        <div class="care">
          <h3>{{ page.header.care_title|default('Starostlivosť po zákroku') }}</h3>
          <div class="care-list">
          {% for c in page.header.care %}
            <div class="care-step"><span class="cn">{{ loop.index }}</span><p><strong>{{ c.title }}</strong>{{ c.text }}</p></div>
          {% endfor %}
          </div>
          <p class="pnote" style="text-align:center">{{ page.header.care_note }}</p>
        </div>
      </div>
    </section>
  </div>

  <!-- KURZY -->
  <div class="view" id="kurzy">
    <section>
      <div class="wrap">
        <div class="head"><span class="kicker">Vzdelávanie</span><h2>{{ page.header.kurzy_title|default('Kurzy — pripravujeme') }}</h2><p>{{ page.header.kurzy_lead }}</p></div>
        <p class="pnote" style="text-align:center;max-width:600px;margin:0 auto 28px">{{ page.header.kurzy_note }}</p>
        <div style="text-align:center"><a class="btn gold" data-go="kontakt" href="#kontakt">Mám záujem o kurz</a></div>
      </div>
    </section>
  </div>

  <!-- CENNIK -->
  <div class="view" id="cennik">
    <section>
      <div class="wrap">
        <div class="head"><span class="kicker">Cenník</span><h2>Prehľadné ceny</h2></div>
        <div class="price">
{% for g in page.header.cennik %}
          <div class="price-group">
            <h3>{{ g.title }}</h3>
            {% for it in g.items %}
            <div class="prow"><div class="l">{{ it.name }}{% if it.desc %}<small>{{ it.desc }}</small>{% endif %}</div><div class="r">{{ it.price }}</div></div>
            {% endfor %}
          </div>
{% endfor %}
        </div>
        <p class="pnote">Ceny sú orientačné, finálnu cenu potvrdíme pri konzultácii. Rezervovať termín môžete online alebo telefonicky.</p>
        <div style="text-align:center;margin-top:24px"><a class="btn gold" href="{{ page.header.c_booking }}" target="_blank" rel="noopener">Objednať sa online</a></div>
      </div>
    </section>
  </div>

  <!-- GALERIA -->
  <div class="view" id="galeria">
    <section>
      <div class="wrap">
        <div class="head"><span class="kicker">Fotogaléria</span><h2>Výsledky</h2></div>
        <h3 class="gal-sub">Permanentný make-up</h3>
        <div class="gal">
        {% for it in page.header.gallery_pmu %}{% set m = page.media[it.media] %}
          <div class="frame"><div class="ph square">{% if it.media ends with '.mp4' or it.media ends with '.mov' %}<video src="{{ m ? m.url : '' }}" autoplay muted loop playsinline></video>{% else %}<img src="{{ m ? m.url : '' }}" alt="{{ it.label }}">{% endif %}{% if it.label %}<span class="lab">{{ it.label }}</span>{% endif %}</div></div>
        {% endfor %}</div>
        <h3 class="gal-sub">Nechty</h3>
        <div class="gal">
        {% for it in page.header.gallery_nechty %}{% set m = page.media[it.media] %}
          <div class="frame"><div class="ph square">{% if it.media ends with '.mp4' or it.media ends with '.mov' %}<video src="{{ m ? m.url : '' }}" autoplay muted loop playsinline></video>{% else %}<img src="{{ m ? m.url : '' }}" alt="{{ it.label }}">{% endif %}{% if it.label %}<span class="lab">{{ it.label }}</span>{% endif %}</div></div>
        {% endfor %}</div>
        <p class="pnote">Aktuálne práce nájdete na Instagrame <a href="https://www.instagram.com/veronikatoth_phibrows/" target="_blank" rel="noopener"><strong>@veronikatoth_phibrows</strong></a>.</p>
      </div>
    </section>
  </div>

  <!-- KONTAKT -->
  <div class="view" id="kontakt">
    <section>
      <div class="wrap">
        <div class="head"><span class="kicker">Kontakt</span><h2>Objednajte sa</h2></div>
        <div class="contact">
          <div class="cinfo">
            <div class="r"><div class="k">Adresa</div><div class="v">{{ page.header.c_addr }}<small>{{ page.header.c_addr_note }}</small></div></div>
            <div class="r"><div class="k">Telefón</div><div class="v"><a href="tel:{{ page.header.c_phone|replace({' ':''}) }}">{{ page.header.c_phone }}</a></div></div>
            <div class="r"><div class="k">E-mail</div><div class="v"><a href="mailto:{{ page.header.c_email }}">{{ page.header.c_email }}</a></div></div>
            <div class="r"><div class="k">Instagram</div><div class="v"><a href="https://www.instagram.com/{{ page.header.c_ig|replace({'@':''}) }}/" target="_blank" rel="noopener">{{ page.header.c_ig }}</a></div></div>
            <div class="r"><div class="k">Objednávky</div><div class="v">{{ page.header.c_hours }}<small>{{ page.header.c_hours_note }}</small></div></div>
            <div class="r"><div class="k">Storno</div><div class="v">Termín zrušte prosím min. 24 h vopred<small>Pri neskoršom zrušení môže byť účtovaný poplatok</small></div></div>
            <div class="book"><a class="btn gold" href="{{ page.header.c_booking }}" target="_blank" rel="noopener">Objednať sa online</a></div>
          </div>
          <form class="cform">
            <div><label for="c-name">Meno</label><input id="c-name" name="name" type="text" required></div>
            <div><label for="c-phone">Telefón</label><input id="c-phone" name="phone" type="tel"></div>
            <div><label for="c-msg">Správa</label><textarea id="c-msg" name="message" rows="4"></textarea></div>
            <button class="btn gold" type="submit">Odoslať dopyt</button>
          </form>
        </div>
        <div class="map-embed" id="mapBox">
          <div class="map-ph" id="mapPh"><p>Mapa sa načíta z Google Máp. Načítaním súhlasíte so spracovaním podľa <a data-go="ochrana-udajov" href="#ochrana-udajov">ochrany osobných údajov</a>.</p><button type="button" class="btn gold map-load">Zobraziť mapu</button></div>
          <iframe title="Mapa — Pražská 11, Nitra" data-src="https://www.google.com/maps?q=Pra%C5%BEsk%C3%A1%2011%2C%20Nitra&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" hidden></iframe>
        </div>
      </div>
    </section>
  </div>

  <!-- OCHRANA OSOBNYCH UDAJOV -->
  <div class="view" id="ochrana-udajov">
    <section>
      <div class="wrap">
        <div class="head"><span class="kicker">Právne</span><h2>Ochrana osobných údajov</h2></div>
        <div class="legal">
          {{ page.header.gdpr|markdown }}
        </div>
        <div style="text-align:center;margin-top:36px"><a class="btn" data-go="uvod" href="#uvod">Späť na úvod</a></div>
      </div>
    </section>
  </div>
</main>

<div class="lb" id="lightbox" hidden>
  <button class="lb-close" id="lbClose" aria-label="Zavrieť">&times;</button>
  <button class="lb-nav lb-prev" id="lbPrev" aria-label="Predchádzajúce">&lsaquo;</button>
  <div class="lb-stage" id="lbStage"></div>
  <button class="lb-nav lb-next" id="lbNext" aria-label="Ďalšie">&rsaquo;</button>
</div>

<div class="cookiebar" id="cookiebar" hidden>
  <p>Táto stránka používa nevyhnutné cookies a po vašom súhlase aj obsah tretích strán (Google Mapy). Viac v <a data-go="ochrana-udajov" href="#ochrana-udajov">ochrane osobných údajov</a>.</p>
  <div class="cb-actions">
    <button id="cbDecline">Len nevyhnutné</button>
    <button class="acc" id="cbAccept">Prijať všetko</button>
  </div>
</div>

<footer>
  <div class="wrap">
    <img class="foot-logo" src="{{ theme_url }}/images/logo-white.png" alt="Veronika Tóth — permanent make-up" data-go="uvod">
    <nav>
      <button data-go="sluzby">Služby</button><button data-go="kurzy">Kurzy</button><button data-go="cennik">Cenník</button><button data-go="galeria">Galéria</button><button data-go="kontakt">Kontakt</button>
    </nav>
    <a class="foot-ig" href="https://www.instagram.com/veronikatoth_phibrows/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg> @veronikatoth_phibrows</a>
    <div class="fb">© <span id="year"></span> Veronika Tóth · Pražská 11, Nitra · +421 903 810 610</div>
    <div class="fb" style="margin-top:6px"><button data-go="ochrana-udajov" style="background:none;border:0;color:rgba(255,255,255,.55);cursor:pointer;font-family:var(--body);font-size:12px;letter-spacing:.04em;text-decoration:underline">Ochrana osobných údajov</button> · IČO: [doplniť]</div>
  </div>
</footer>

<script src="{{ theme_url }}/js/app.js"></script>
